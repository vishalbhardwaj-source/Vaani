# Gnani AI API Credentials
# Sign in to https://app.gnani.ai to get your API key (5,000 credits allocated)
GNANI_API_KEY=your_gnani_api_key_here

# Gnani API Endpoints (vachana.ai)
GNANI_PRISMA_URL=https://api.vachana.ai/stt/v3
GNANI_EVON_URL=https://api.vachana.ai/v1/evon/chat
GNANI_TIMBRE_URL=https://api.vachana.ai/api/v1/tts/inference

# Optional fallback LLM provider
GEMINI_API_KEY=

# Default Model Selections (Gnani AI)
ASR_ENGINE=prisma
LLM_PROVIDER=Gnani Evon v3.3 (Hosted API)
